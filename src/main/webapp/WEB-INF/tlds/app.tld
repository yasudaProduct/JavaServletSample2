<?xml version="1.0" encoding="UTF-8"?>
<taglib xmlns="http://java.sun.com/xml/ns/javaee" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://java.sun.com/xml/ns/javaee http://java.sun.com/xml/ns/javaee/web-jsptaglibrary_2_1.xsd" version="2.1">
  <tlib-version>1.0</tlib-version>
  <short-name>app</short-name>
  <uri>/WEB-INF/tlds/app.tld</uri>
  <function><name>date</name><function-class>com.example.appmgmt.web.view.Fn</function-class><function-signature>java.lang.String date(java.time.LocalDate)</function-signature></function>
  <function><name>datetime</name><function-class>com.example.appmgmt.web.view.Fn</function-class><function-signature>java.lang.String datetime(java.time.LocalDateTime)</function-signature></function>
  <function><name>amount</name><function-class>com.example.appmgmt.web.view.Fn</function-class><function-signature>java.lang.String amount(java.math.BigDecimal)</function-signature></function>
  <function><name>ratio</name><function-class>com.example.appmgmt.web.view.Fn</function-class><function-signature>java.lang.String ratio(java.math.BigDecimal)</function-signature></function>
  <function><name>label</name><function-class>com.example.appmgmt.web.view.Fn</function-class><function-signature>java.lang.String label(java.lang.String, java.lang.String)</function-signature></function>
  <function><name>text</name><function-class>com.example.appmgmt.web.view.Fn</function-class><function-signature>java.lang.String text(java.lang.Object)</function-signature></function>
  <function><name>differs</name><function-class>com.example.appmgmt.web.view.Fn</function-class><function-signature>boolean differs(java.lang.Object, java.lang.Object)</function-signature></function>
</taglib>
