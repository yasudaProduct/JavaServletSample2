<%-- 申込内容（申込者情報を含む）の入力欄。form：ApplicationForm、errors：項目名→メッセージ、amountsOnly：金額項目だけ編集可、base：比較元の版（任意）、
     companyExtra：会社B の追加項目欄（toggle = SC04。担当会社の選択で表示を切り替える、fixed = 会社B の申込の SC07／SC08、空 = 出さない（AP02 など）） --%>
<c:set var="ro" value="${amountsOnly ? 'readonly' : ''}"/>
<h3 class="h6 section-title mt-0">申込者情報</h3>
<div class="form-row">
  <div class="form-group col-md-4">
    <label for="applicantName">申込者名 <span class="badge badge-danger">必須</span></label>
    <input type="text" class="form-control ${not empty errors.applicantName ? 'is-invalid' : ''}" id="applicantName" name="applicantName" maxlength="100" value="<c:out value='${form.applicantName}'/>" ${ro}>
    <c:if test="${not empty base}"><small class="form-text text-muted">比較元：<c:out value="${app:text(base.applicantName)}"/></small></c:if>
    <div class="invalid-feedback"><c:out value="${errors.applicantName}"/></div>
  </div>
  <div class="form-group col-md-4">
    <label for="applicantKana">申込者名カナ</label>
    <input type="text" class="form-control ${not empty errors.applicantKana ? 'is-invalid' : ''}" id="applicantKana" name="applicantKana" maxlength="100" value="<c:out value='${form.applicantKana}'/>" placeholder="全角カタカナ" ${ro}>
    <c:if test="${not empty base}"><small class="form-text text-muted">比較元：<c:out value="${app:text(base.applicantKana)}"/></small></c:if>
    <div class="invalid-feedback"><c:out value="${errors.applicantKana}"/></div>
  </div>
  <div class="form-group col-md-4">
    <label for="telNo">電話番号</label>
    <input type="text" class="form-control ${not empty errors.telNo ? 'is-invalid' : ''}" id="telNo" name="telNo" maxlength="15" value="<c:out value='${form.telNo}'/>" placeholder="例：03-0000-0000" ${ro}>
    <c:if test="${not empty base}"><small class="form-text text-muted">比較元：<c:out value="${app:text(base.telNo)}"/></small></c:if>
    <div class="invalid-feedback"><c:out value="${errors.telNo}"/></div>
  </div>
</div>
<div class="form-row">
  <div class="form-group col-md-5">
    <label for="mailAddress">メールアドレス <span class="badge badge-danger">必須</span></label>
    <input type="email" class="form-control ${not empty errors.mailAddress ? 'is-invalid' : ''}" id="mailAddress" name="mailAddress" maxlength="254" value="<c:out value='${form.mailAddress}'/>" ${ro}>
    <c:if test="${not empty base}"><small class="form-text text-muted">比較元：<c:out value="${app:text(base.mailAddress)}"/></small></c:if>
    <small class="form-text text-muted">確認依頼メールと申込者アカウント通知の宛先です。</small>
    <div class="invalid-feedback"><c:out value="${errors.mailAddress}"/></div>
  </div>
  <div class="form-group col-md-7">
    <label for="address">住所</label>
    <input type="text" class="form-control ${not empty errors.address ? 'is-invalid' : ''}" id="address" name="address" maxlength="200" value="<c:out value='${form.address}'/>" ${ro}>
    <c:if test="${not empty base}"><small class="form-text text-muted">比較元：<c:out value="${app:text(base.address)}"/></small></c:if>
    <div class="invalid-feedback"><c:out value="${errors.address}"/></div>
  </div>
</div>
<h3 class="h6 section-title">申込内容</h3>
<div class="form-row">
  <div class="form-group col-md-4">
    <label for="productCd">商品コード <span class="badge badge-danger">必須</span></label>
    <input type="text" class="form-control ${not empty errors.productCd ? 'is-invalid' : ''}" id="productCd" name="productCd" maxlength="10" value="<c:out value='${form.productCd}'/>" ${ro}>
    <c:if test="${not empty base}"><small class="form-text text-muted">比較元：<c:out value="${app:text(base.productCd)}"/></small></c:if>
    <div class="invalid-feedback"><c:out value="${errors.productCd}"/></div>
  </div>
</div>
<div class="form-row">
  <div class="form-group col-md-3">
    <label for="basicFee">基本料金（円） <span class="badge badge-danger">必須</span></label>
    <input type="text" class="form-control text-right amount-input ${not empty errors.basicFee ? 'is-invalid' : ''}" id="basicFee" name="basicFee" maxlength="17" value="<c:out value='${form.basicFee}'/>" inputmode="numeric">
    <c:if test="${not empty base}"><small class="form-text text-muted">比較元：${app:amount(base.basicFee)}</small></c:if>
    <div class="invalid-feedback"><c:out value="${errors.basicFee}"/></div>
  </div>
  <div class="form-group col-md-3">
    <label for="optionFee">オプション料金（円）</label>
    <input type="text" class="form-control text-right amount-input ${not empty errors.optionFee ? 'is-invalid' : ''}" id="optionFee" name="optionFee" maxlength="17" value="<c:out value='${form.optionFee}'/>" inputmode="numeric">
    <c:if test="${not empty base}"><small class="form-text text-muted">比較元：${app:amount(base.optionFee)}</small></c:if>
    <div class="invalid-feedback"><c:out value="${errors.optionFee}"/></div>
  </div>
  <div class="form-group col-md-3">
    <label for="handlingFee">事務手数料（円）</label>
    <input type="text" class="form-control text-right amount-input ${not empty errors.handlingFee ? 'is-invalid' : ''}" id="handlingFee" name="handlingFee" maxlength="17" value="<c:out value='${form.handlingFee}'/>" inputmode="numeric">
    <c:if test="${not empty base}"><small class="form-text text-muted">比較元：${app:amount(base.handlingFee)}</small></c:if>
    <div class="invalid-feedback"><c:out value="${errors.handlingFee}"/></div>
  </div>
  <div class="form-group col-md-3">
    <label>申込金額合計（円）</label>
    <input type="text" class="form-control-plaintext text-right font-weight-bold" id="totalAmount" value="<c:out value='${form.totalAmount}'/>" readonly>
    <c:if test="${not empty base}"><small class="form-text text-muted">比較元：${app:amount(base.totalAmount)}　倍率：<span id="ratioPreview">－</span>（しきい値 ${app:ratio(ratioLimit)}）</small></c:if>
  </div>
</div>
<div class="form-row">
  <div class="form-group col-md-3">
    <label for="contractStartDate">契約開始日</label>
    <input type="text" class="form-control ${not empty errors.contractStartDate ? 'is-invalid' : ''}" id="contractStartDate" name="contractStartDate" placeholder="yyyy/MM/dd" maxlength="10" value="<c:out value='${form.contractStartDate}'/>" ${ro}>
    <c:if test="${not empty base}"><small class="form-text text-muted">比較元：${app:date(base.contractStartDate)}</small></c:if>
    <div class="invalid-feedback"><c:out value="${errors.contractStartDate}"/></div>
  </div>
  <div class="form-group col-md-3">
    <label for="contractEndDate">契約終了日</label>
    <input type="text" class="form-control ${not empty errors.contractEndDate ? 'is-invalid' : ''}" id="contractEndDate" name="contractEndDate" placeholder="yyyy/MM/dd" maxlength="10" value="<c:out value='${form.contractEndDate}'/>" ${ro}>
    <c:if test="${not empty base}"><small class="form-text text-muted">比較元：${app:date(base.contractEndDate)}</small></c:if>
    <div class="invalid-feedback"><c:out value="${errors.contractEndDate}"/></div>
  </div>
</div>
<div class="form-group">
  <label for="remarks">備考</label>
  <textarea class="form-control ${not empty errors.remarks ? 'is-invalid' : ''}" id="remarks" name="remarks" rows="3" maxlength="1000" ${ro}><c:out value="${form.remarks}"/></textarea>
  <c:if test="${not empty base}"><small class="form-text text-muted pre-wrap">比較元：<c:out value="${app:text(base.remarks)}"/></small></c:if>
  <div class="invalid-feedback"><c:out value="${errors.remarks}"/></div>
</div>
<c:if test="${not empty companyExtra}">
<c:set var="extraOn" value="${companyExtra == 'fixed' or form.companyExtraTarget}"/>
<div id="companyExtra" ${extraOn ? '' : 'hidden'}>
<h3 class="h6 section-title">会社B 追加項目</h3>
<div class="form-row">
  <div class="form-group col-md-4">
    <label for="corporateNo">法人番号</label>
    <input type="text" class="form-control ${not empty errors.corporateNo ? 'is-invalid' : ''}" id="corporateNo" name="corporateNo" maxlength="13" value="<c:out value='${form.corporateNo}'/>" placeholder="半角数字 13 桁" inputmode="numeric" ${ro} ${extraOn ? '' : 'disabled'}>
    <c:if test="${not empty base}"><small class="form-text text-muted">比較元：<c:out value="${app:text(base.corporateNo)}"/></small></c:if>
    <div class="invalid-feedback"><c:out value="${errors.corporateNo}"/></div>
  </div>
  <div class="form-group col-md-8">
    <label for="installPlace">設置場所</label>
    <input type="text" class="form-control ${not empty errors.installPlace ? 'is-invalid' : ''}" id="installPlace" name="installPlace" maxlength="200" value="<c:out value='${form.installPlace}'/>" ${ro} ${extraOn ? '' : 'disabled'}>
    <c:if test="${not empty base}"><small class="form-text text-muted">比較元：<c:out value="${app:text(base.installPlace)}"/></small></c:if>
    <div class="invalid-feedback"><c:out value="${errors.installPlace}"/></div>
  </div>
</div>
<div class="form-group">
  <label for="contactMemo">窓口メモ</label>
  <textarea class="form-control ${not empty errors.contactMemo ? 'is-invalid' : ''}" id="contactMemo" name="contactMemo" rows="2" maxlength="500" ${ro} ${extraOn ? '' : 'disabled'}><c:out value="${form.contactMemo}"/></textarea>
  <c:if test="${not empty base}"><small class="form-text text-muted pre-wrap">比較元：<c:out value="${app:text(base.contactMemo)}"/></small></c:if>
  <div class="invalid-feedback"><c:out value="${errors.contactMemo}"/></div>
</div>
<p class="small text-muted">担当会社が会社B の申込だけの項目です（いずれも任意）。入力内容による制御はありません。</p>
</div>
</c:if>
