<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="http://xmlns.jcp.org/xml/ns/javaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee http://xmlns.jcp.org/xml/ns/javaee/web-app_4_0.xsd"
         version="4.0">
  <display-name>申込管理システム</display-name>

  <listener>
    <listener-class>com.example.appmgmt.web.AppInitializer</listener-class>
  </listener>
  <listener>
    <listener-class>com.example.appmgmt.infra.scheduler.BatchScheduler</listener-class>
  </listener>

  <!-- Filter（順序どおりに適用） -->
  <filter>
    <filter-name>encodingFilter</filter-name>
    <filter-class>com.example.appmgmt.web.filter.EncodingFilter</filter-class>
  </filter>
  <filter-mapping>
    <filter-name>encodingFilter</filter-name>
    <url-pattern>/*</url-pattern>
  </filter-mapping>

  <filter>
    <filter-name>securityHeadersFilter</filter-name>
    <filter-class>com.example.appmgmt.web.filter.SecurityHeadersFilter</filter-class>
  </filter>
  <filter-mapping>
    <filter-name>securityHeadersFilter</filter-name>
    <url-pattern>/*</url-pattern>
  </filter-mapping>

  <filter>
    <filter-name>employeeAuthFilter</filter-name>
    <filter-class>com.example.appmgmt.web.filter.EmployeeAuthFilter</filter-class>
  </filter>
  <filter-mapping>
    <filter-name>employeeAuthFilter</filter-name>
    <url-pattern>/emp/*</url-pattern>
  </filter-mapping>

  <filter>
    <filter-name>csrfFilter</filter-name>
    <filter-class>com.example.appmgmt.web.filter.CsrfFilter</filter-class>
  </filter>
  <filter-mapping>
    <filter-name>csrfFilter</filter-name>
    <url-pattern>/emp/*</url-pattern>
  </filter-mapping>
  <filter-mapping>
    <filter-name>csrfFilter</filter-name>
    <url-pattern>/consent/*</url-pattern>
  </filter-mapping>
  <filter-mapping>
    <filter-name>csrfFilter</filter-name>
    <url-pattern>/my/*</url-pattern>
  </filter-mapping>

  <filter>
    <filter-name>applicantAuthFilter</filter-name>
    <filter-class>com.example.appmgmt.web.filter.ApplicantAuthFilter</filter-class>
  </filter>
  <filter-mapping>
    <filter-name>applicantAuthFilter</filter-name>
    <url-pattern>/my/*</url-pattern>
  </filter-mapping>

  <filter>
    <filter-name>apiAuthFilter</filter-name>
    <filter-class>com.example.appmgmt.web.filter.ApiAuthFilter</filter-class>
  </filter>
  <filter-mapping>
    <filter-name>apiAuthFilter</filter-name>
    <url-pattern>/api/external/*</url-pattern>
  </filter-mapping>

  <!-- Servlet -->
  <servlet>
    <servlet-name>login</servlet-name>
    <servlet-class>com.example.appmgmt.web.servlet.LoginServlet</servlet-class>
  </servlet>
  <servlet-mapping>
    <servlet-name>login</servlet-name>
    <url-pattern>/emp/login</url-pattern>
    <url-pattern>/emp/logout</url-pattern>
  </servlet-mapping>

  <servlet>
    <servlet-name>applications</servlet-name>
    <servlet-class>com.example.appmgmt.web.servlet.ApplicationsServlet</servlet-class>
  </servlet>
  <servlet-mapping>
    <servlet-name>applications</servlet-name>
    <url-pattern>/emp/applications/*</url-pattern>
  </servlet-mapping>

  <servlet>
    <servlet-name>import</servlet-name>
    <servlet-class>com.example.appmgmt.web.servlet.ImportServlet</servlet-class>
    <multipart-config>
      <max-file-size>5242880</max-file-size>
      <max-request-size>6291456</max-request-size>
      <file-size-threshold>0</file-size-threshold>
    </multipart-config>
  </servlet>
  <servlet-mapping>
    <servlet-name>import</servlet-name>
    <url-pattern>/emp/import/*</url-pattern>
  </servlet-mapping>

  <servlet>
    <servlet-name>master</servlet-name>
    <servlet-class>com.example.appmgmt.web.servlet.MasterServlet</servlet-class>
    <!-- SC17 同意事項マスタの PDF アップロード（10MB まで） -->
    <multipart-config>
      <max-file-size>10485760</max-file-size>
      <max-request-size>11534336</max-request-size>
      <file-size-threshold>0</file-size-threshold>
    </multipart-config>
  </servlet>
  <servlet-mapping>
    <servlet-name>master</servlet-name>
    <url-pattern>/emp/master/*</url-pattern>
  </servlet-mapping>

  <servlet>
    <servlet-name>devTools</servlet-name>
    <servlet-class>com.example.appmgmt.web.servlet.DevToolsServlet</servlet-class>
  </servlet>
  <servlet-mapping>
    <servlet-name>devTools</servlet-name>
    <url-pattern>/emp/dev/*</url-pattern>
  </servlet-mapping>

  <servlet>
    <servlet-name>consent</servlet-name>
    <servlet-class>com.example.appmgmt.web.servlet.ConsentServlet</servlet-class>
  </servlet>
  <servlet-mapping>
    <servlet-name>consent</servlet-name>
    <url-pattern>/consent/*</url-pattern>
  </servlet-mapping>

  <servlet>
    <servlet-name>my</servlet-name>
    <servlet-class>com.example.appmgmt.web.servlet.MyServlet</servlet-class>
  </servlet>
  <servlet-mapping>
    <servlet-name>my</servlet-name>
    <url-pattern>/my/*</url-pattern>
  </servlet-mapping>

  <servlet>
    <servlet-name>externalResultApi</servlet-name>
    <servlet-class>com.example.appmgmt.web.api.ExternalResultApiServlet</servlet-class>
  </servlet>
  <servlet-mapping>
    <servlet-name>externalResultApi</servlet-name>
    <url-pattern>/api/external/*</url-pattern>
  </servlet-mapping>

  <servlet>
    <servlet-name>home</servlet-name>
    <servlet-class>com.example.appmgmt.web.servlet.HomeServlet</servlet-class>
  </servlet>
  <servlet-mapping>
    <servlet-name>home</servlet-name>
    <url-pattern>/emp</url-pattern>
    <url-pattern>/emp/</url-pattern>
  </servlet-mapping>

  <welcome-file-list>
    <welcome-file>index.jsp</welcome-file>
  </welcome-file-list>

  <session-config>
    <session-timeout>30</session-timeout>
    <cookie-config>
      <http-only>true</http-only>
    </cookie-config>
    <tracking-mode>COOKIE</tracking-mode>
  </session-config>

  <jsp-config>
    <jsp-property-group>
      <url-pattern>*.jsp</url-pattern>
      <page-encoding>UTF-8</page-encoding>
      <trim-directive-whitespaces>false</trim-directive-whitespaces>
      <include-prelude>/WEB-INF/views/common/prelude.jspf</include-prelude>
    </jsp-property-group>
    <!-- 静的インクルードする断片（.jspf）の文字コード -->
    <jsp-property-group>
      <url-pattern>*.jspf</url-pattern>
      <page-encoding>UTF-8</page-encoding>
      <trim-directive-whitespaces>false</trim-directive-whitespaces>
    </jsp-property-group>
  </jsp-config>

  <error-page>
    <exception-type>java.lang.Throwable</exception-type>
    <location>/WEB-INF/views/common/error.jsp</location>
  </error-page>
  <error-page>
    <error-code>404</error-code>
    <location>/WEB-INF/views/common/notfound.jsp</location>
  </error-page>
</web-app>
